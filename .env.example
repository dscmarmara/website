# =========================================================================
# Environment template. Copy to .env.local and fill in real values:
#     cp .env.example .env.local
# .env.local is gitignored; this file (no secrets) is committed as docs.
#
# EXPOSURE: only NEXT_PUBLIC_* vars reach the browser; the rest are server-only.
# =========================================================================

# --- Zoho Mail, for the contact form (server-only) ---
# Create a Self Client at api-console.zoho.eu, then generate a grant code with
# scope ZohoMail.messages.CREATE,ZohoMail.accounts.READ and exchange it:
#     node scripts/zoho-refresh-token.mjs <grant_code>
# Without these the form logs the message server-side instead of sending it.
ZOHO_REGION=eu          # eu | com | in — must match your Zoho data centre
ZOHO_CLIENT_ID=         # Self Client → Client ID
ZOHO_CLIENT_SECRET=     # Self Client → Client Secret
ZOHO_REFRESH_TOKEN=     # from scripts/zoho-refresh-token.mjs (does not expire)
ZOHO_ACCOUNT_ID=        # optional: skips the accounts lookup if set

CONTACT_INBOX=          # where the form delivers, e.g. iletisim@dscmarmara.com.tr
CONTACT_FROM=           # sending mailbox — MUST be the account's PRIMARY address
# Do not point CONTACT_FROM at an alias. Measured against Zoho: sending from an
# alias with an arbitrary Reply-To is rejected ("You need to verify the ReplyTo
# address"), and the alias buys nothing anyway — the client still labels the mail
# "Me" because the alias is still the account's own address. The primary address
# is the only one that accepts a per-visitor Reply-To, which is what lets the club
# hit Reply and answer the visitor directly.

# --- Public ---
NEXT_PUBLIC_SITE_URL=   # public site URL (defaulted in code if unset)
